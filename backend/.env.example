# Uygulama Ayarları
APP_NAME="OSINT Security Crawler"
DEBUG_MODE=True

# Veritabanı Ayarları
# Örnek SQLite (Yerel Geliştirme İçin): sqlite:///../osint_crawler.db
# Örnek PostgreSQL (Canlı Ortam İçin): postgresql://kullanici:sifre@localhost:5432/osint_db
DATABASE_URL="sqlite:///../osint_crawler.db"

# Güvenlik ve CORS 
# React genelde 3000, Vite ise 5173 portunu kullanır
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"