# Uygulama Ayarları
APP_NAME="OSINT Security Crawler"

# Veritabanı Ayarları
# Örnek SQLite (Yerel Geliştirme İçin): sqlite:///../data/osint_crawler.db
# Örnek PostgreSQL (Canlı Ortam İçin): postgresql://kullanici:sifre@localhost:5432/osint_db
# Not: Docker Compose bu değeri sqlite:////data/osint_crawler.db ile ezer.
DATABASE_URL="sqlite:///../data/osint_crawler.db"
LOG_DIR="../logs"

# Güvenlik ve CORS 
# React genelde 3000, Vite ise 5173 portunu kullanır
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
# API isteklerinin maksimum gövde boyutu (byte)
MAX_REQUEST_BODY_BYTES=1048576

# Tarayıcı (Crawler) Ayarları
CRAWLER_USER_AGENT="OSINT-Advisory-Crawler/1.0 (+https://github.com/TahaEmirUzun/osint-web-crawler; public security advisory research)"
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_RETRIES=3
CRAWLER_MAX_PAGES_LIMIT=500
CRAWLER_MAX_DEPTH_LIMIT=3
CRAWLER_MIN_DELAY_SECONDS=1

# Otomatik periyodik tarama aralığı (saat). 0 verilirse kapanır.
AUTO_CRAWL_INTERVAL_HOURS=12
# Kaynak tablosu boşsa ilk açılışta yüklenecek onaylı kaynak listesi
SEED_SOURCES_FILE="config/sources.json"
